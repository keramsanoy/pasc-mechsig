# Copy to .env (git-ignored) and fill in your site's values. init.py reads this
# file; nothing here is stored in the repository.

# OMOP CDM database (thesis: AIR·MS, SAP HANA, OMOP CDM v5.3)
OMOP_DB_HOST=db.example.org
OMOP_DB_PORT=30015
OMOP_DB_NAME=OMOP
OMOP_DB_USER=
# Leave the password empty to be prompted interactively instead.
OMOP_DB_PASSWORD=

# Schema holding the CDM tables. The SQL names it as CDMPHI (AIR·MS); any other
# value is substituted at execution time (see init.py).
OMOP_CDM_SCHEMA=CDMPHI

# SSH tunnel from a compute node to the database (1/0). Default: on, unless the
# current host name starts with OMOP_LOGIN_NODE_PREFIX.
OMOP_USE_SSH_TUNNEL=0
OMOP_SSH_LOGIN_HOSTS=login1,login2
OMOP_SSH_LOGIN_HOST=
OMOP_LOGIN_NODE_PREFIX=

# TLS settings passed to hdbcli
OMOP_ENCRYPT=TRUE
OMOP_SSL_VALIDATE_CERTIFICATE=FALSE
OMOP_SSL_HOSTNAME_IN_CERT=
OMOP_SSL_TRUSTSTORE=None
OMOP_CONNECT_TIMEOUT=0

# Where the cohort cache and the results go (default: inside the repository)
# PASC_COHORT_DIR=/scratch/you/pasc/cohort_parquets
# PASC_RESULTS_DIR=/scratch/you/pasc/results
